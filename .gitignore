# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc

# Content-pipeline debug dumps (regenerated by scripts/build_content.py)
platform/scripts/_debug/

# Copyrighted source material: the scanned books the "real" question banks were
# transcribed from. The books themselves stay out of the repository. The
# per-question figure crops under platform/public/figures/ are checked in and
# served by the app — the site is private and non-commercial, and for dozens of
# questions (an elephant, a cat's face, a brick wall) the book's own figure is
# the only faithful one. Regenerate them with scripts/extract_figures.py.
Docs/*.pdf
Docs/*.docx
Docs/_staging/
